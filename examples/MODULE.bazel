"Examples for rules_bdeg"

module(name = "rules_bdeg_examples")

# Use local rules_bdeg
bazel_dep(name = "rules_bdeg", version = "0.0.0")
local_path_override(
    module_name = "rules_bdeg",
    path = "..",
)

# C++ rules
bazel_dep(name = "rules_cc", version = "0.2.1")

# Dependencies to export
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "boost.program_options", version = "1.87.0")

# For boost
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")
archive_override(
    module_name = "rules_boost",
    strip_prefix = "rules_boost-master",
    urls = ["https://github.com/nelhage/rules_boost/archive/refs/heads/master.tar.gz"],
)
