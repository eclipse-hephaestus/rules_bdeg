"Bazel Dependency Export Generator - Export Bazel C++ dependencies as CMake packages"

module(
    name = "rules_bdeg",
    version = "0.1.0",
    compatibility_level = 1,
)

# Required for CcInfo provider
bazel_dep(name = "rules_cc", version = "0.2.1")

# Required for platforms
bazel_dep(name = "platforms", version = "0.0.10")

# Required for Starlark utilities
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Contributor-only tooling: formatting (//:format), copyright checks
# (//:copyright) and packaging. None of it is needed to *use* cmake_export.
#
# These must stay dev_dependency = True. Bazel module dependencies are
# inherited, so without this flag anyone adding `bazel_dep(name =
# "rules_bdeg")` would also inherit score_tooling - which is published in the
# Eclipse S-CORE registry rather than the Bazel Central Registry. Their build
# would fail to resolve a module they never asked for unless they also
# registered that extra registry.
#
# dev_dependency = True means "ignored when rules_bdeg is consumed as a
# dependency", while still being available here in its own repository.
bazel_dep(name = "score_tooling", version = "2.2.1", dev_dependency = True)
bazel_dep(name = "aspect_rules_lint", version = "2.3.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)
